[Unit]
Description=Photon geocoder (instance %i)
After=network.target

[Service]
Type=simple
User=freemap
WorkingDirectory=/opt/photon
# Supplies PHOTON_PORT; a template cannot derive a port from %i on its own.
EnvironmentFile=/opt/photon/photon-instance.%i.conf
ExecStart=java -Xms1g -Xmx8g -jar /opt/photon/photon-1.3.0.jar \
  -data-dir /opt/photon/photon-data.%i \
  -listen-ip 127.0.0.1 -listen-port ${PHOTON_PORT} -cors-any
# Lucene keeps many segment files open; the systemd default of 1024 is too low
LimitNOFILE=65535
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
