// Gravel bike, on top of bike.json + bike_elevation.json: it seeks the firm
// unpaved surfaces a racing bike shuns, without following an mtb onto technical
// trail. bike.json already blocks mtb_rating > 2, so the clause below only ever
// bites at exactly 2, which is mtb:scale=0.
//
// `smoothness` as well as `surface`, because the two say different things: a
// way OSM calls gravel and VERY_BAD is mtb ground whatever it is surfaced with,
// and the mtb_rating block above it only catches the ones where somebody
// bothered to tag an mtb:scale.
{
  "priority": [
    {
      "if": "surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL",
      "multiply_by": "1.5"
    },
    { "else_if": "surface == GROUND || surface == DIRT", "multiply_by": "1.1" },
    { "if": "track_type == GRADE4 || track_type == GRADE5", "multiply_by": "0.4" },
    { "if": "mtb_rating >= 2", "multiply_by": "0.3" },
    {
      "if": "smoothness == VERY_BAD || smoothness == HORRIBLE || smoothness == VERY_HORRIBLE || smoothness == IMPASSABLE",
      "multiply_by": "0.2"
    }
  ]
}
