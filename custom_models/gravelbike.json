// Gravel bike, on top of bike.json + bike_elevation.json: it seeks the firm
// unpaved surfaces a racing bike shuns, without following an mtb onto technical
// trail.
//
// bike.json blocks `mtb_rating > 2`, so the clause below only ever bites at
// exactly 2. Note what that value is: `OSMMtbRatingParser` shifts the scale by
// one — "mtb:scale=0 corresponds to mtb_rating=1 because mtb_rating=0 is the
// default" — so 2 is **mtb:scale=1**, rocks and roots wanting basic technical
// skill, not the smooth mtb:scale=0. Leaving 1 (mtb:scale=0) unpenalised is
// deliberate: a solid smooth track is exactly what this profile is looking for.
//
// Everything else here is graded rather than lumped, on the same argument as
// stroller.json: `bad` and `impassable` are not the same claim, and neither are
// grade4 and grade5. No slope ladder, because unlike ebike.json this profile
// keeps bike_elevation.json's gradient handling — legs, not a motor.
//
// `smoothness` as well as `surface`, because the two say different things: a
// way OSM calls gravel and VERY_BAD is mtb ground whatever it is surfaced with,
// and the mtb_rating clause only catches the ones where somebody bothered to
// tag an mtb:scale. They compound, which is intended — a coarse surface that is
// also badly kept really is two problems.
//
// Four groups multiplying needs a floor, though: this is a CH profile, and
// `CHStorage` turns any shortcut weight past ~4.29e6 into the infinity marker.
// The worst product here is 0.2 x 0.3 x 0.3 x 0.1 = 1.8e-3, which at bike.json's
// 4 km/h pushing speed is ~500 per metre and so clears an 8 km shortcut.
{
  "priority": [
    { "if": "surface == COMPACTED", "multiply_by": "1.5" },
    { "else_if": "surface == FINE_GRAVEL", "multiply_by": "1.45" },
    { "else_if": "surface == GRAVEL", "multiply_by": "1.3" },
    { "else_if": "surface == UNPAVED", "multiply_by": "1.15" },
    { "else_if": "surface == GROUND || surface == DIRT", "multiply_by": "1.1" },
    { "else_if": "surface == PAVING_STONES", "multiply_by": "0.85" },
    { "else_if": "surface == WOOD", "multiply_by": "0.7" },
    { "else_if": "surface == GRASS", "multiply_by": "0.55" },
    { "else_if": "surface == COBBLESTONE", "multiply_by": "0.5" },
    { "else_if": "surface == SAND", "multiply_by": "0.2" },

    { "if": "track_type == GRADE2", "multiply_by": "1.2" },
    { "else_if": "track_type == GRADE4", "multiply_by": "0.55" },
    { "else_if": "track_type == GRADE5", "multiply_by": "0.3" },

    { "if": "mtb_rating >= 2", "multiply_by": "0.3" },

    { "if": "smoothness == IMPASSABLE", "multiply_by": "0" },
    { "else_if": "smoothness == VERY_HORRIBLE", "multiply_by": "0.1" },
    { "else_if": "smoothness == HORRIBLE", "multiply_by": "0.2" },
    { "else_if": "smoothness == VERY_BAD", "multiply_by": "0.35" },
    { "else_if": "smoothness == BAD", "multiply_by": "0.7" }
  ]
}
