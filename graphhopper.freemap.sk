server {

	server_name graphhopper.freemap.sk;

	access_log /var/log/nginx/access_graphhopper.log;
	error_log /var/log/nginx/error_graphhopper.log warn;

	location / {
		# `/match` takes the whole track as one POST body, and nginx's stock 1 MiB
		# turns a long recording into a 413 in its own HTML.
		client_max_body_size 8m;

		# Which instance serves traffic. gh-update.sh flips this symlink between
		# graphhopper-upstream.{a,b}.conf and reloads nginx. One vhost and two
		# one-line fragments rather than two whole vhosts, as in Photon: the TLS
		# config, the body limit and the log paths then cannot drift between the
		# two sides, and there is exactly one line per side that can be wrong.
		include /opt/graphhopper/graphhopper-upstream.conf;
	}

	listen 443 ssl; # managed by Certbot
	listen [::]:443 ssl; # managed by Certbot

	ssl_certificate /etc/letsencrypt/live/graphhopper.freemap.sk/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/graphhopper.freemap.sk/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
	if ($host = graphhopper.freemap.sk) {
		return 301 https://$host$request_uri;
	} # managed by Certbot

	listen 80;
	listen [::]:80;

	server_name graphhopper.freemap.sk;
	return 404; # managed by Certbot
}
