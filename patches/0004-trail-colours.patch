+package com.graphhopper.routing.ev;
+
+import com.graphhopper.util.Helper;
+
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.HashSet;
+
+/**
+ * The waymark colour of a hiking or cycling route relation. One bit each in the
+ * {@link HikingColours} and {@link BikeColours} masks, because a way commonly carries several
+ * routes of different colours and every one of them is worth showing.
+ * <p>
+ * The eight named colours are the ones that actually occur on European route relations; everything
+ * else recognisable as a colour - the rarer names and the hex values - collapses into OTHER, which
+ * keeps such a way marked without spending a bit per long tail value.
+ */
+public enum TrailColour {
+
+    RED, BLUE, GREEN, YELLOW, BLACK, ORANGE, GRAY, WHITE, OTHER;
+
+    /**
+     * Bits needed to store any combination of these.
+     */
+    public static final int BITS = values().length;
+
+    private static final Collection<String> OTHER_NAMES = new HashSet<>(Arrays.asList(
+            "brown", "purple", "violet", "teal", "cyan", "aqua", "pink", "magenta", "fuchsia",
+            "maroon", "olive", "navy", "lime", "silver", "gold", "beige", "turquoise"));
+
+    public int bit() {
+        return 1 << ordinal();
+    }
+
+    /**
+     * @return the colour for a single OSM colour value, or null when the value is not a colour at
+     * all. Junk has to be distinguishable from a colour we merely do not store, because the parser
+     * falls back from osmc:symbol to the colour tag on null and would otherwise stop at the first
+     * unparsable symbol.
+     */
+    public static TrailColour find(String value) {
+        if (Helper.isEmpty(value))
+            return null;
+        String v = Helper.toLowerCase(value).trim();
+        switch (v) {
+            case "red":
+                return RED;
+            case "blue":
+                return BLUE;
+            case "green":
+                return GREEN;
+            case "yellow":
+                return YELLOW;
+            case "black":
+                return BLACK;
+            case "orange":
+                return ORANGE;
+            case "gray":
+            case "grey":
+                return GRAY;
+            case "white":
+                return WHITE;
+            default:
+                return OTHER_NAMES.contains(v) || isHex(v) ? OTHER : null;
+        }
+    }
+
+    private static boolean isHex(String v) {
+        if (v.charAt(0) != '#' || (v.length() != 4 && v.length() != 7))
+            return false;
+        for (int i = 1; i < v.length(); i++) {
+            char c = v.charAt(i);
+            if ((c < '0' || c > '9') && (c < 'a' || c > 'f'))
+                return false;
+        }
+        return true;
+    }
+
+    @Override
+    public String toString() {
+        return Helper.toLowerCase(super.toString());
+    }
+}
