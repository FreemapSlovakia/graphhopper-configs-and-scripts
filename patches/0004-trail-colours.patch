+package com.graphhopper.routing.util.parsers;
+
+import com.graphhopper.reader.ReaderRelation;
+import com.graphhopper.reader.ReaderWay;
+import com.graphhopper.routing.ev.*;
+import com.graphhopper.storage.IntsRef;
+import com.graphhopper.util.Helper;
+
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.HashSet;
+
+import static com.graphhopper.routing.util.EncodingManager.getKey;
+
+/**
+ * Collects the waymark colours of the route relations an edge belongs to into a
+ * {@link TrailColour} bit mask - hiking_colours from walking routes, bike_colours from cycling
+ * ones.
+ * <p>
+ * Unlike the network parsers this never has to resolve a conflict: OSMReader hands each relation
+ * the flags accumulated from the way's earlier relations, so overlapping routes simply OR their
+ * bits together and relation order does not matter.
+ * <p>
+ * Colour comes from the first field of osmc:symbol - the waycolour - and falls back to the colour
+ * tag, which is not a rare case but the usual one outside walking routes: across Europe 69 % of
+ * route=hiking relations carry osmc:symbol against 18 % with colour, while for route=bicycle it is
+ * 2 % against 16 %. Neither tag alone is enough.
+ */
+public class OSMTrailColourParser implements RelationTagParser {
+
+    public static final Collection<String> HIKING_ROUTES = new HashSet<>(Arrays.asList("hiking", "foot"));
+    public static final Collection<String> BIKE_ROUTES = new HashSet<>(Arrays.asList("bicycle", "mtb"));
+
+    private final IntEncodedValue colourEnc;
+    private final Collection<String> routeValues;
+    // used for internal transformation from relations into colourEnc
+    private final IntEncodedValue transformerColourRelEnc;
+
+    public OSMTrailColourParser(IntEncodedValue colourEnc, Collection<String> routeValues, String prefix,
+                                EncodedValue.InitializerConfig relConfig) {
+        this.colourEnc = colourEnc;
+        this.routeValues = routeValues;
+        this.transformerColourRelEnc = new IntEncodedValueImpl(getKey(prefix, "colour_relation"), TrailColour.BITS, false);
+        this.transformerColourRelEnc.init(relConfig);
+    }
+
+    @Override
+    public void handleRelationTags(IntsRef relFlags, ReaderRelation relation) {
+        if (!routeValues.contains(Helper.toLowerCase(relation.getTag("route", ""))))
+            return;
+
+        int mask = colourMask(relation);
+        if (mask == 0)
+            return;
+
+        IntsRefEdgeIntAccess relIntAccess = new IntsRefEdgeIntAccess(relFlags);
+        int old = transformerColourRelEnc.getInt(false, -1, relIntAccess);
+        if ((old | mask) != old)
+            transformerColourRelEnc.setInt(false, -1, relIntAccess, old | mask);
+    }
+
+    @Override
+    public void handleWayTags(int edgeId, EdgeIntAccess edgeIntAccess, ReaderWay way, IntsRef relationFlags) {
+        // just copy value into different bit range
+        IntsRefEdgeIntAccess relIntAccess = new IntsRefEdgeIntAccess(relationFlags);
+        colourEnc.setInt(false, edgeId, edgeIntAccess, transformerColourRelEnc.getInt(false, -1, relIntAccess));
+    }
+
+    private int colourMask(ReaderRelation relation) {
+        String osmcSymbol = relation.getTag("osmc:symbol", "");
+        if (!osmcSymbol.isEmpty()) {
+            // waycolour:background:foreground..., only the waycolour is the colour of the mark
+            int mask = parse(osmcSymbol.split(":", 2)[0]);
+            if (mask != 0)
+                return mask;
+        }
+        // an unparsable symbol is not an absent one: fall through to the colour tag rather than
+        // let a value like 'greenbl' hide a perfectly good colour=green beside it
+        int mask = parse(relation.getTag("colour", ""));
+        return mask != 0 ? mask : parse(relation.getTag("color", ""));
+    }
+
+    private int parse(String value) {
+        if (value.isEmpty())
+            return 0;
+        int mask = 0;
+        for (String part : value.split(";")) {
+            TrailColour colour = TrailColour.find(part);
+            if (colour != null)
+                mask |= colour.bit();
+        }
+        return mask;
+    }
+}
diff --git a/core/src/test/java/com/graphhopper/routing/util/parsers/OSMTrailColourParserTest.java b/core/src/test/java/com/graphhopper/routing/util/parsers/OSMTrailColourParserTest.java
new file mode 100644
index 000000000..ab45bf3dc
--- /dev/null
+++ b/core/src/test/java/com/graphhopper/routing/util/parsers/OSMTrailColourParserTest.java
@@ -0,0 +1,127 @@
+package com.graphhopper.routing.util.parsers;
+
+import com.graphhopper.reader.ReaderRelation;
+import com.graphhopper.reader.ReaderWay;
+import com.graphhopper.routing.ev.*;
+import com.graphhopper.routing.util.EncodingManager;
+import com.graphhopper.storage.IntsRef;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class OSMTrailColourParserTest {
+
+    private final IntEncodedValue hikingEnc = HikingColours.create();
+    private final IntEncodedValue bikeEnc = BikeColours.create();
+    @SuppressWarnings("unused") // initializes the edge encoded values above
+    private final EncodingManager em = new EncodingManager.Builder().add(hikingEnc).add(bikeEnc).build();
+    private final EncodedValue.InitializerConfig relConfig = new EncodedValue.InitializerConfig();
+    private final OSMTrailColourParser hiking = new OSMTrailColourParser(hikingEnc,
+            OSMTrailColourParser.HIKING_ROUTES, "hiking", relConfig);
+    private final OSMTrailColourParser bike = new OSMTrailColourParser(bikeEnc,
+            OSMTrailColourParser.BIKE_ROUTES, "bike", relConfig);
+
+    private ReaderRelation route(String routeValue, String key, String value) {
+        ReaderRelation relation = new ReaderRelation(1);
+        relation.setTag("type", "route");
+        relation.setTag("route", routeValue);
+        relation.setTag(key, value);
+        return relation;
+    }
+
+    private int hikingColoursOf(ReaderRelation... relations) {
+        IntsRef relFlags = new IntsRef(2);
+        for (ReaderRelation relation : relations) {
+            hiking.handleRelationTags(relFlags, relation);
+            bike.handleRelationTags(relFlags, relation);
+        }
+        ArrayEdgeIntAccess edgeIntAccess = new ArrayEdgeIntAccess(1);
+        hiking.handleWayTags(0, edgeIntAccess, new ReaderWay(1), relFlags);
+        return hikingEnc.getInt(false, 0, edgeIntAccess);
+    }
+
+    private int bikeColoursOf(ReaderRelation... relations) {
+        IntsRef relFlags = new IntsRef(2);
+        for (ReaderRelation relation : relations) {
+            hiking.handleRelationTags(relFlags, relation);
+            bike.handleRelationTags(relFlags, relation);
+        }
+        ArrayEdgeIntAccess edgeIntAccess = new ArrayEdgeIntAccess(1);
+        bike.handleWayTags(0, edgeIntAccess, new ReaderWay(1), relFlags);
+        return bikeEnc.getInt(false, 0, edgeIntAccess);
+    }
+
+    @Test
+    public void testOsmcSymbolWaycolour() {
+        assertEquals(TrailColour.RED.bit(),
+                hikingColoursOf(route("hiking", "osmc:symbol", "red:white:red_bar")));
+    }
+
+    @Test
+    public void testColourFallback() {
+        // route=bicycle almost never carries osmc:symbol, the colour tag is what it has
+        assertEquals(TrailColour.GREEN.bit(),
+                bikeColoursOf(route("bicycle", "colour", "green")));
+    }
+
+    @Test
+    public void testUnparsableSymbolFallsThroughToColour() {
+        ReaderRelation relation = route("hiking", "osmc:symbol", "greenbl");
+        relation.setTag("colour", "green");
+        assertEquals(TrailColour.GREEN.bit(), hikingColoursOf(relation));
+    }
+
+    @Test
+    public void testOverlappingRoutesAreOred() {
+        assertEquals(TrailColour.RED.bit() | TrailColour.GREEN.bit(),
+                hikingColoursOf(route("hiking", "colour", "red"), route("foot", "colour", "green")));
+    }
+
+    @Test
+    public void testSemicolonSeparatedValues() {
+        assertEquals(TrailColour.YELLOW.bit() | TrailColour.BLUE.bit(),
+                hikingColoursOf(route("hiking", "colour", "yellow;blue")));
+    }
+
+    @Test
+    public void testGreyIsGray() {
+        assertEquals(TrailColour.GRAY.bit(), hikingColoursOf(route("hiking", "colour", "grey")));
+        assertEquals(TrailColour.GRAY.bit(), hikingColoursOf(route("hiking", "colour", "gray")));
+    }
+
+    @Test
+    public void testRareColoursAndHexBecomeOther() {
+        assertEquals(TrailColour.OTHER.bit(), hikingColoursOf(route("hiking", "colour", "teal")));
+        assertEquals(TrailColour.OTHER.bit(), hikingColoursOf(route("hiking", "colour", "brown")));
+        assertEquals(TrailColour.OTHER.bit(), hikingColoursOf(route("hiking", "colour", "#C61D23")));
+    }
+
+    @Test
+    public void testJunkIsNotAColour() {
+        assertEquals(0, hikingColoursOf(route("hiking", "colour", "none")));
+        assertEquals(0, hikingColoursOf(route("hiking", "colour", "#12345")));
+        assertEquals(0, hikingColoursOf(route("hiking", "osmc:symbol", "greenbl")));
+    }
+
+    @Test
+    public void testMasksDoNotLeakIntoEachOther() {
+        ReaderRelation cycling = route("bicycle", "colour", "blue");
+        assertEquals(0, hikingColoursOf(cycling));
+        assertEquals(TrailColour.BLUE.bit(), bikeColoursOf(cycling));
+
+        ReaderRelation walking = route("hiking", "colour", "red");
+        assertEquals(0, bikeColoursOf(walking));
+        assertEquals(TrailColour.RED.bit(), hikingColoursOf(walking));
+    }
+
+    @Test
+    public void testMtbCountsAsCycling() {
+        assertEquals(TrailColour.ORANGE.bit(), bikeColoursOf(route("mtb", "colour", "orange")));
+    }
+
+    @Test
+    public void testUnmarkedStaysZero() {
+        assertEquals(0, hikingColoursOf(route("hiking", "network", "rwn")));
+        assertEquals(0, hikingColoursOf(route("bus", "colour", "red")));
+    }
+}
