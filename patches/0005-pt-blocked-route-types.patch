 .../resources/PtRouteResource.java            |  2 ++
 .../resources/PtRouteResourceTest.java        | 30 +++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/web-bundle/src/main/java/com/graphhopper/resources/PtRouteResource.java b/web-bundle/src/main/java/com/graphhopper/resources/PtRouteResource.java
index 3ff069d6a..c03953639 100644
--- a/web-bundle/src/main/java/com/graphhopper/resources/PtRouteResource.java
+++ b/web-bundle/src/main/java/com/graphhopper/resources/PtRouteResource.java
@@ -71,6 +71,7 @@ public class PtRouteResource {
                             @QueryParam("pt.limit_solutions") Integer limitSolutions,
                             @QueryParam("pt.limit_trip_time") DurationParam limitTripTime,
                             @QueryParam("pt.limit_street_time") DurationParam limitStreetTime,
+                            @QueryParam("pt.blocked_route_types") @DefaultValue("0") int blockedRouteTypes,
                             @QueryParam("pt.access_profile") String accessProfile,
                             @QueryParam("pt.beta_access_time") Double betaAccessTime,
                             @QueryParam("pt.egress_profile") String egressProfile,
@@ -91,6 +92,7 @@ public class PtRouteResource {
         Optional.ofNullable(limitSolutions).ifPresent(request::setLimitSolutions);
         Optional.ofNullable(limitTripTime.get()).ifPresent(request::setLimitTripTime);
         Optional.ofNullable(limitStreetTime.get()).ifPresent(request::setLimitStreetTime);
+        request.setBlockedRouteTypes(blockedRouteTypes);
         Optional.ofNullable(accessProfile).ifPresent(request::setAccessProfile);
         Optional.ofNullable(betaAccessTime).ifPresent(request::setBetaAccessTime);
         Optional.ofNullable(egressProfile).ifPresent(request::setEgressProfile);
diff --git a/web/src/test/java/com/graphhopper/application/resources/PtRouteResourceTest.java b/web/src/test/java/com/graphhopper/application/resources/PtRouteResourceTest.java
index 68b35a31a..6c0001313 100644
--- a/web/src/test/java/com/graphhopper/application/resources/PtRouteResourceTest.java
+++ b/web/src/test/java/com/graphhopper/application/resources/PtRouteResourceTest.java
@@ -71,6 +71,36 @@ public class PtRouteResourceTest {
         Helper.removeDir(new File(DIR));
     }
 
+    @Test
+    public void testBlockedRouteTypesRemovesTheOnlyMode() {
+        // NADAV -> NANAA is served by route_type 3 (bus) only; blocking bit 3 leaves nothing to board
+        JsonNode jsonNode = clientTarget(app, "/route")
+                .queryParam("point", "Stop(NADAV)")
+                .queryParam("point", "Stop(NANAA)")
+                .queryParam("profile", "pt")
+                .queryParam("pt.earliest_departure_time", "2007-01-01T15:44:00Z")
+                .queryParam("pt.blocked_route_types", 1 << 3)
+                .request().get(JsonNode.class);
+        // a walking path may still be returned; what must not survive is a transit leg
+        JsonNode legs = jsonNode.at("/paths/0/legs");
+        for (JsonNode leg : legs)
+            assertNotEquals("pt", leg.path("type").asText(), "transit leg survived a blocked route type: " + legs);
+    }
+
+    @Test
+    public void testBlockedRouteTypesIgnoresOtherModes() {
+        // blocking rail (bit 2) must leave the bus connection alone
+        JsonNode jsonNode = clientTarget(app, "/route")
+                .queryParam("point", "Stop(NADAV)")
+                .queryParam("point", "Stop(NANAA)")
+                .queryParam("profile", "pt")
+                .queryParam("pt.earliest_departure_time", "2007-01-01T15:44:00Z")
+                .queryParam("pt.blocked_route_types", 1 << 2)
+                .request().get(JsonNode.class);
+        assertEquals(1, jsonNode.at("/paths/0/legs").size());
+        assertEquals("pt", jsonNode.at("/paths/0/legs/0/type").asText());
+    }
+
