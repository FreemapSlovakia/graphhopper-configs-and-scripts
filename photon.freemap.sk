server {

	server_name photon.freemap.sk;

	access_log /var/log/nginx/access_photon.log;
	error_log /var/log/nginx/error_photon.log warn;

	# nginx.conf enables gzip but leaves gzip_types at the default (text/html only)
	gzip_types application/json;

	location / {
		# 20 r/s sustained, bursts to 40: autocomplete fires per keystroke, so a
		# low limit hurts real users sharing one carrier NAT.
		limit_req zone=photon_req burst=40 nodelay;
		limit_req_status 429;

		# Deliberately uncached. A proxy_cache here returned 8.5% hits on real
		# /api traffic, saving ~20ms each — a few seconds of Photon CPU a day
		# against a 59 GB mmap'd index that answers in 13-27ms uncached. It cost
		# more than it saved: a monitor on a fixed URL got a HIT and went green
		# whether or not Photon was alive, proxy_cache_use_stale hid real
		# outages, the switchover had to purge it through a sudoers rule, and
		# keying on $request_uri meant blanking Accept-Language so one client's
		# language could not leak into another's cached response. Revisit if
		# traffic grows by an order of magnitude; abuse is limit_req's job, not
		# the cache's.

		# Which instance serves traffic. photon-update.sh flips this symlink
		# between photon-upstream.{a,b}.conf and reloads nginx.
		include /opt/photon/photon-upstream.conf;
	}

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/photon.freemap.sk/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/photon.freemap.sk/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = photon.freemap.sk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	listen 80;
	listen [::]:80;

	server_name photon.freemap.sk;
    return 404; # managed by Certbot


}
