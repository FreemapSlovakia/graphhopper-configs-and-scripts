[Unit]
Description=GraphHopper OSM update
# gh-update.sh emails its own results. This covers only the deaths where it
# never got the chance to: OOM kill, SIGKILL, watchdog.
OnFailure=gh-update-abort.service

[Service]
Type=oneshot
User=freemap
WorkingDirectory=/opt/graphhopper
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/stdbuf -oL -eL /opt/graphhopper/gh-update.sh
